{
  "name": "7-wonders-duel-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run check && npm run smoke && npm run sim -- 100",
    "sim": "tsx scripts/simulate.ts",
    "soloSim": "tsx scripts/soloSim.ts",
    "soloAgoraSim": "tsx scripts/soloAgoraSim.ts",
    "soloPantheonSim": "tsx scripts/soloPantheonSim.ts",
    "soloPantheonSim:combo": "tsx scripts/soloPantheonSim.ts 12 medium combo",
    "check": "tsx scripts/checkLayout.ts",
    "smoke": "tsx scripts/renderSmoke.tsx",
    "replay": "tsx scripts/replayCheck.ts",
    "bench": "tsx scripts/aiBench.ts",
    "server": "tsx server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist-server/server.mjs",
    "server:start": "node dist-server/server.mjs",
    "proto": "tsx scripts/protoTest.ts",
    "proto:prod": "tsx scripts/protoProd.ts",
    "proto:ai": "tsx scripts/protoAiTakeover.ts",
    "sim:p": "tsx scripts/simulate.ts --pantheon",
    "replay:p": "tsx scripts/replayCheck.ts --pantheon",
    "bench:p": "tsx scripts/aiBench.ts --pantheon",
    "proto:p": "tsx scripts/protoTest.ts --pantheon",
    "proto:ai:p": "tsx scripts/protoAiTakeover.ts --pantheon",
    "sim:a": "tsx scripts/simulate.ts --agora",
    "replay:a": "tsx scripts/replayCheck.ts --agora",
    "bench:a": "tsx scripts/aiBench.ts --agora",
    "proto:a": "tsx scripts/protoTest.ts --agora",
    "proto:ai:a": "tsx scripts/protoAiTakeover.ts --agora",
    "browser:e2e": "node scripts/browser/e2eClickFlow.cjs",
    "perf": "tsx scripts/perfReport.ts",
    "deploy:docker": "docker build -t 7-wonders-duel ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "tsx": "^4.19.2"
  }
}
